	(text "Voltage, Current through the divider (PYRO continuity good, MOSFET off):\n\nV_{PYRO_FAULT} = 24V x R_{2} / (R_{1} + R_{2}) = 3.0V\n\nR_{2} / (R_{1} + R_{2}) = 0.125\n\nI_{R1,R2} = 24V / (R_{1} + R_{2}) = 24V / 80kΩ = 300 µA\n\nPower in R_{1}, R_{2}:\n\nP_{R_{1}} = I_{R1,R2}^{2} × R_{1} = (300µA)^2 × 70,000Ω = 6.3 mW\n\nP_{R_{2}} = I_{R1,R2}^{2} × R_{2} = (300µA)^2 × 10,000Ω = 0.9 mW"
		(exclude_from_sim no)
		(at 192.786 93.726 0)
		(effects
			(font
				(face "KiCad Font")
				(size 1.27 1.27)
			)
		)
		(uuid "f5c4e723-78da-47f7-a9c6-e8cc62de5b4e")
	)
